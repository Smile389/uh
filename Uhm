            Wheel.InputBegan:Connect(function(Input) if not Enabled then return end if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then DragWheel = true end end)
            ValSlide.InputBegan:Connect(function(Input) if not Enabled then return end if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then DragVal = true end end)
            AlphaSlide.InputBegan:Connect(function(Input) if not Enabled then return end if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then DragAlpha = true end end)

            UserInputService.InputEnded:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                    DragWheel = false; DragVal = false; DragAlpha = false
                end
            end)

            UserInputService.InputChanged:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
                    if DragWheel then
                        local AbsPos = Wheel.AbsolutePosition
                        local AbsSize = Wheel.AbsoluteSize
                        local MousePos = UserInputService:GetMouseLocation()
                        local Center = AbsPos + (AbsSize / 2)
                        local Vector = MousePos - Center
                        local Angle = math.atan2(Vector.Y, Vector.X)
                        local Radius = AbsSize.X / 2
                        local Dist = math.clamp(Vector.Magnitude / Radius, 0, 1)
                        HSV.H = (Angle + math.pi) / (math.pi * 2)
                        HSV.S = Dist
                        local CursorPos = Vector2.new(math.cos(Angle), math.sin(Angle)) * (Dist * Radius)
                        Cursor.Position = UDim2.new(0.5, CursorPos.X, 0.5, CursorPos.Y)
                        Update()
                    elseif DragVal then
                         local MousePos = UserInputService:GetMouseLocation()
                         local RelY = math.clamp((MousePos.Y - ValSlide.AbsolutePosition.Y) / ValSlide.AbsoluteSize.Y, 0, 1)
                         HSV.V = 1 - RelY
                         Update()
                    elseif DragAlpha then
                         local MousePos = UserInputService:GetMouseLocation()
                         local RelY = math.clamp((MousePos.Y - AlphaSlide.AbsolutePosition.Y) / AlphaSlide.AbsoluteSize.Y, 0, 1)
                         Alpha = 1 - RelY
                         Update()
                    end
                end
            end)

            local Open = false
            ColorPreview.MouseButton1Click:Connect(function()
                if not Enabled then return end
                Open = not Open
                Tween(ColorFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, Open and 220 or 42)})
            end)
            
            local Element = {}
            Element.Value = Default
            function Element:SetValue(c, a) HSV = {H=0, S=0, V=1}; Alpha=a; Update(); Element.Value = c end
            
            Library.Items[Flag] = { 
                Type = "Colorpicker", 
                Set = function(val) 
                    local h,s,v = Color3.toHSV(val)
                    HSV = {H=h, S=s, V=v}
                    Update() 
                    Element.Value = val
                end 
            }

            return Element
        end

