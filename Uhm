    local function FilterElements(text)
        text = text:lower()
        for _, page in pairs(Pages:GetChildren()) do
            if page:IsA("ScrollingFrame") or page:IsA("CanvasGroup") then
                local content = page:FindFirstChild("ScrollingFrame") or page
                for _, el in pairs(content:GetChildren()) do
                    if el:IsA("GuiObject") and el:FindFirstChild("TextLabel") then 
                        local label = el:FindFirstChild("TextLabel")
                        if label and label.Text:lower():find(text) then
                            el.Visible = true
                        else
                            if not el:IsA("UIListLayout") and not el:IsA("UIPadding") and not el:IsA("TextLabel") then
                                el.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end

