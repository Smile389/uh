local function SafeWriteFile(name, data)
    if not isfolder(FolderName) then makefolder(FolderName) end
    local SerializedData = {}
    for k, v in pairs(data) do
        if typeof(v) == "Color3" then
            SerializedData[k] = {R = v.R, G = v.G, B = v.B, Type = "Color3"}
        elseif typeof(v) == "EnumItem" then
            SerializedData[k] = {Name = v.Name, EnumType = tostring(v.EnumType), Type = "Enum"}
        else
            SerializedData[k] = v
        end
    end
    writefile(FolderName .. "/" .. name .. ".json", HttpService:JSONEncode(SerializedData))
end

local function SafeReadFile(name)
    if not isfolder(FolderName) then return nil end
    if not isfile(FolderName .. "/" .. name .. ".json") then return nil end
    local success, result = pcall(function()
        local decoded = HttpService:JSONDecode(readfile(FolderName .. "/" .. name .. ".json"))
        local deserialized = {}
        for k, v in pairs(decoded) do
            if type(v) == "table" and v.Type == "Color3" then
                deserialized[k] = Color3.new(v.R, v.G, v.B)
            elseif type(v) == "table" and v.Type == "Enum" then
                if v.EnumType == "Enum.KeyCode" then
                    deserialized[k] = Enum.KeyCode[v.Name]
                else
                    deserialized[k] = v
                end
            else
                deserialized[k] = v
            end
        end
        return deserialized
    end)
    if success then return result end
    return nil
end

local function DeleteConfigFile(name)
    if isfile(FolderName .. "/" .. name .. ".json") then
        delfile(FolderName .. "/" .. name .. ".json")
    end
end

local function GetConfigs()
    if not isfolder(FolderName) then makefolder(FolderName) end
    local files = listfiles(FolderName)
    local configs = {}
    for _, file in pairs(files) do
        if file:sub(-5) == ".json" then
            local name = file:gsub(FolderName .. "\\", ""):gsub(FolderName .. "/", ""):gsub(".json", "")
            table.insert(configs, name)
        end
    end
    return configs
end

