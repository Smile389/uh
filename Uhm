                Value = math.clamp(Value, Min, Max)
                local SizeX = (Value - Min) / (Max - Min)
                Tween(Fill, TweenInfo.new(0.05), {Size = UDim2.new(SizeX, 0, 1, 0)})
                ValueLabel.Text = tostring(Value)
                Library.Flags[Flag] = Value
                if Config.Callback then Config.Callback(Value) end
            end

            local function Update(Input)
                local SizeX = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local RawValue = Min + ((Max - Min) * SizeX)
                
                local Quantized = math.round(RawValue / Increment) * Increment
                local Decimals = 0
                if math.floor(Increment) ~= Increment then
                    Decimals = tostring(Increment):split(".")[2]:len()
                end
                Quantized = tonumber(string.format("%."..Decimals.."f", Quantized))
                
                SetValue(Quantized)
            end

            Track.InputBegan:Connect(function(Input)
                if not Enabled then return end
                if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true
